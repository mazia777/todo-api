              "host": ["{{base_url}}"],
              "path": ["api", "todos", ":id"]
            }
          }
        },
        {
          "name": "Update (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated title\",\n  \"description\": \"Updated description\",\n  \"completed\": true,\n  \"due_at\": \"2030-01-02 10:00:00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/todos/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "todos", ":id"]
            }
          }
        },
        {
          "name": "Update (PATCH)",
          "request": {
