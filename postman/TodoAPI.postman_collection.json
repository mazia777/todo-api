                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"completed\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/todos/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "todos", ":id"]
            }
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/todos/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "todos", ":id"]
            }
          }
        }
      ]
    }
  ]
}
